# Host ports for the dev environment. Copy to .env and change if these clash.
WEB_PORT=8100
DB_PORT=3327
PMA_PORT=8101

# PHP the web container runs. The plugin supports 7.4 through the latest 8.x; re-run
# ./scripts/bootstrap.sh after changing it.
PHP_VERSION=7.4

# Used by the Playwright suite.
BASE_URL=http://localhost:8100
